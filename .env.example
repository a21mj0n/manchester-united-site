# Ma'lumotlar bazasi (SQLite fayl yo'li)
# Lokal:   file:./prisma/dev.db
# Server:  file:/var/www/manchester-united-site/data/app.db
DATABASE_URL="file:./prisma/dev.db"

# Sessiya cookie'sini imzolash uchun kalit (kamida 32 belgi).
# Yaratish: openssl rand -base64 48
AUTH_SECRET=""

# Admin paroli xeshi. Yaratish: npm run admin:password
ADMIN_PASSWORD_HASH=""

# Telegram bildirishnomalari (ixtiyoriy).
# Bo'sh qoldirilsa, bildirishnoma yuborilmaydi — sayt baribir ishlaydi.
# Bot yaratish: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=""
# Chat ID: botga xabar yozib, https://api.telegram.org/bot<TOKEN>/getUpdates ni oching
TELEGRAM_CHAT_ID=""

# API-Football kaliti (ixtiyoriy) — jamoa tarkibi uchun.
# Bo'sh qoldirilsa demo tarkib ko'rsatiladi.
# Olish: dashboard.api-football.com
FOOTBALL_API_KEY=""

# Anthropic API kaliti (ixtiyoriy) — yangilik sarlavhalarini
# o'zbekchaga o'girish uchun. Bo'sh bo'lsa sarlavhalar asl tilida qoladi.
ANTHROPIC_API_KEY=""

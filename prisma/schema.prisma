// Red Devils Uzbekistan — ma'lumotlar bazasi sxemasi
//
// SQLite tanlandi: alohida server jarayoni talab qilmaydi va
// qo'shimcha xotira olmaydi. Keyinchalik Postgres'ga o'tish uchun
// provider ni almashtirib, migratsiyalarni qayta yaratish yetarli.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Fan-klubga kelib tushgan arizalar
model FanApplication {
  id        Int      @id @default(autoincrement())
  name      String
  city      String
  contact   String
  /// Nechanchi yildan beri muxlis (ixtiyoriy)
  since     Int?
  /// new | approved | rejected
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

/// Bosh sahifadagi yangiliklar kartalari
model NewsPost {
  id        Int      @id @default(autoincrement())
  title     String
  excerpt   String
  /// Karta ustidagi yorliq: "Fan-klub", "Transfer", "Tarix"…
  tag       String   @default("Yangilik")
  /// Yorliq rangi: red | gold | default
  tagColor  String   @default("default")
  /// Fon naqshi raqami (1-4)
  image     Int      @default(1)
  /// Karta pastidagi kichik matn: "Har hafta · Toshkent"
  meta      String   @default("")
  /// Bosh sahifada katta karta sifatida ko'rsatilsinmi
  featured  Boolean  @default(false)
  published Boolean  @default(true)

  /// Tashqi manbadan olingan bo'lsa: manba nomi va asl maqola havolasi.
  /// Maqola matni ko'chirilmaydi — faqat sarlavha, qisqa tavsif va havola.
  sourceName String?
  sourceUrl  String?
  /// Takrorlanmasligi uchun manbadagi guid
  externalId String? @unique
  /// Maqola manbada chop etilgan vaqt
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

/// Jamoa tarkibi — kunlik sinxronizatsiya to'ldiradi
model Player {
  id       Int     @id @default(autoincrement())
  /// Tashqi API dagi identifikator. Qo'lda qo'shilgan o'yinchida bo'lmaydi.
  apiId    Int?    @unique
  num      Int
  name     String
  /// GK | DF | MF | FW
  pos      String
  posName  String
  age      Int?
  photo    String?
  country  String?
  /// Akademiya yoki zaxira o'yinchisi.
  /// API bunday maydon bermaydi — lib/sync/run.ts dagi qoida bo'yicha
  /// hisoblanadi (yosh va raqam takrorlanishi asosida).
  isAcademy Boolean @default(false)

  /// Admin qo'lda qo'shgan o'yinchi — sinxronizatsiya uni o'chirmaydi.
  /// Manba tarkibni chala bergan holatlar uchun (masalan API 2026 mavsumida
  /// de Ligt'ni ko'rsatmagan edi).
  manual Boolean @default(false)
  /// Admin guruhni qo'lda belgilagan bo'lsa shu qiymat ustun turadi
  /// va kunlik sinxronizatsiya uni buzmaydi.
  academyOverride Boolean?

  updatedAt DateTime @updatedAt

  @@index([pos, num])
}

/// O'yinlar — kelgusi va o'tgan. Hisob bo'sh bo'lsa o'yin hali bo'lmagan.
model Match {
  id        Int      @id @default(autoincrement())
  /// Tashqi manbadagi identifikator
  extId     String   @unique
  kickoff   DateTime
  homeTeam  String
  awayTeam  String
  homeScore Int?
  awayScore Int?
  competition String
  venue     String?
  /// Jamoa gerblari (Premer-liga SVG havolasi)
  homeBadge String?
  awayBadge String?
  updatedAt DateTime @updatedAt

  @@index([kickoff])
}

/// Turnir jadvali
model StandingRow {
  id      Int     @id @default(autoincrement())
  season  String
  pos     Int
  team    String
  played  Int
  won     Int
  drawn   Int
  lost    Int
  gd      String
  points  Int
  isUnited Boolean @default(false)
  /// Jamoa gerbi (Premer-liga SVG havolasi)
  badge   String?
  /// Joriy mavsum hali boshlanmagani uchun oldingi mavsum ko'rsatilyaptimi
  isPreviousSeason Boolean @default(false)
  updatedAt DateTime @updatedAt

  @@unique([season, team])
  @@index([season, pos])
}

/// Har bir sinxronizatsiya yurishining natijasi
model SyncLog {
  id         Int      @id @default(autoincrement())
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  ok         Boolean  @default(false)
  /// Qaysi bo'lim nima bilan tugadi (JSON matn)
  details    String   @default("")

  @@index([startedAt])
}
